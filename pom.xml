<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>com.automation</groupId><artifactId>playwright-java-framework</artifactId><version>1.0-SNAPSHOT</version>
 <properties>
  <maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  <playwright.version>1.61.0</playwright.version><junit.version>5.12.2</junit.version>
 </properties>
 <dependencies>
  <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>${playwright.version}</version></dependency>
  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
 </dependencies>
 <build><plugins>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
   <configuration><useModulePath>false</useModulePath><systemPropertyVariables><baseURL>${baseURL}</baseURL></systemPropertyVariables></configuration>
  </plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
 </plugins></build>
 <profiles><profile><id>default</id><activation><activeByDefault>true</activeByDefault></activation>
  <properties><baseURL>https://practicesoftwaretesting.com</baseURL></properties></profile></profiles>
</project>
